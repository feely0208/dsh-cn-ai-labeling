{
  "id": "AILABEL-NO-DISCLOSURE",
  "title": "生成结果被直接回给用户的文件里，看不到任何「AI 生成」显式标识",
  "severity": "high",
  "source": "《生成式人工智能服务管理暂行办法》第12条（提供者应当按照规定对生成内容进行标识）；《人工智能生成合成内容标识办法》第4条（显式标识）；《互联网信息服务深度合成管理规定》第17条；GB 45438—2025《网络安全技术 人工智能生成合成内容标识方法》（强制性国标）第 5、6 章；附录 E（规范性）。",
  "advice": "用了 AI 生成，就要让用户看得出来这句话是 AI 生成的。在输出链路（页面渲染、接口响应、消息正文）里加一句显式标识，例如「本内容由 AI 生成」；只写在 README、注释或后台日志里不算 —— 标识必须出现在用户实际看到的那份内容上。这不影响功能，只是把「这句话是谁说的」讲清楚。",
  "check": {
    "type": "file-pattern",
    "when": "(openai|anthropic|deepseek|@deepseek-ai|google\\.generativeai|cohere|zhipuai|dashscope|qianfan|generateText|streamText|chat\\.completions|ChatOpenAI)",
    "wholeFile": true,
    "pattern": "(res|reply|ctx|response|reply_?message)\\.(json|send|reply|write)\\s*\\([^)]{0,200}(ai[A-Z_]|ai_|generateText|generate_text|llm|completion|chat\\.completions)",
    "flags": "gi",
    "exts": [
      ".js",
      ".mjs",
      ".cjs",
      ".ts",
      ".tsx",
      ".jsx",
      ".vue",
      ".svelte",
      ".py",
      ".rb",
      ".php",
      ".go",
      ".java"
    ],
    "exclude": [
      "AI\\s*生成",
      "AI-generated",
      "AI generated",
      "人工智能生成",
      "Generated by AI",
      "本内容由\\s*AI",
      "由 AI 生成",
      "AI 辅助生成"
    ],
    "max": 20
  }
}